# Copy to .env and change every secret before any non-local use.
POSTGRES_USER=app
POSTGRES_PASSWORD=app-dev-password
POSTGRES_DB=running_analyzer
AUTH_DB_PASSWORD=auth-dev-password

# Shared between Supabase Auth (issuer) and the API (verifier). At least 32 characters.
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef

WEB_URL=http://localhost:3000
AUTH_EXTERNAL_URL=http://localhost:9999

S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=minio-dev-password
S3_BUCKET=running-analyzer
# Endpoint the browser can reach for signed upload URLs (the API talks to storage:9000 internally).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Which pipeline worker to run: "cpu" (like the production VPS) or "gpu" (local NVIDIA card).
COMPOSE_PROFILES=cpu

# Email. Unset = Mailpit in development (http://localhost:8025, nothing is really sent).
# Production (Brevo, EU): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<Brevo SMTP login>,
# SMTP_PASSWORD=<Brevo SMTP key>, SMTP_FROM="Running Analyzer <noreply@your-domain>", SMTP_FROM_ADDRESS=noreply@your-domain
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_ADDRESS=
